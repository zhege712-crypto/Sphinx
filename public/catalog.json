:true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"b8a81349-127b-4481-84ab-772b8808862b","content":[{"type":"text","text":"（不过目前你不去用key也可以，因为有dsh可以直接登录ds账号，直接从你账号上的金额扣钱）","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"86a7e5ce-2869-4366-bdb6-ed2a9c025d62","content":[]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"b2a8f88b-fdcb-4f21-8dc3-b20ddb6f9981","content":[]},{"type":"image","props":{"backgroundColor":"default","textAlignment":"left","url":"assets/bdfff1af-0cca-4c1d-b7d6-d91cbafeb2a1.jpg","name":"54B5703C874BE24BCB86E19F67248CA1.png","caption":"","showPreview":true,"previewWidth":560},"id":"b696c316-7fc7-45f7-a9ce-2e1b7088b1af"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"9582bcb8-2776-461b-8510-1e7bcbdc3646","content":[{"type":"text","text":"STEP III  下载","styles":{"bold":true,"underline":true,"textColor":"pink","backgroundColor":"pink"}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"df57cfa1-80b1-4b88-8980-2125ad0ce3f7","content":[]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"38b92feb-c062-4bee-bdf1-d6105b4f5e74","content":[{"type":"text","text":"回到ds官网首页，点击","styles":{"bold":true}},{"type":"link","href":"https://www.deepseek.com/harness/","content":[{"type":"text","text":"Harness桌面端","styles":{"bold":true,"textColor":"red"}}]}]},{"type":"linkCard","props":{"title":"DeepSeekHarness","url":"https://www.deepseek.com/harness/"},"id":"1102cb7a-6b8d-4be3-a964-57d4fb031163"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"7132908d-9847-400f-af61-eac9dbbee6d8","content":[{"type":"text","text":" ","