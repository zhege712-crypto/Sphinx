gnment":"left","url":"assets/33dbc41d-fcef-4b53-8769-d91e319b1343.jpg","name":"IMG_1003.jpeg","caption":"","showPreview":true},"id":"69fba14b-4da2-4f9f-a457-c4530d97a8e0"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"0dd2c983-258a-4fba-9373-98273e2c536b","content":[{"type":"text","text":"直接双击运行它，然后会看见下图","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"2ee7de37-d921-4312-a837-1543cba54fbe","content":[]},{"type":"image","props":{"backgroundColor":"default","textAlignment":"left","url":"assets/9c266767-b851-4a8e-9adf-f5668dbcbb9d.jpg","name":"IMG_1005.jpeg","caption":"","showPreview":true,"previewWidth":357},"id":"33825a31-ae85-494f-941c-9b170cff6817"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"c4b476ec-fce2-422b-94d8-78ff4d2cbece","content":[{"type":"text","text":"STEP IV 配置与使用","styles":{"bold":true,"underline":true,"textColor":"pink","backgroundColor":"pink"}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"91454388-cd33-4036-8084-df634e2aac02","content":[{"type":"text","text":"安装好启动以后，应该是如图所示界面","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"51532623-48c3-485a-a132-d2b30d10d351","content":[]},{"type":"image","props":{"backgroundColor":"default","textAlignment":"left","url":"assets/4268181c-99db-4c62-991b-3f5d853e9e28.jpg","name":"IMG_1007.jpeg","caption":"","showPreview":true,"previewWidth":495},"id":"7ddaa038-82cf-4d1a-a57a-5a83e39828d3"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"499d5ab3-6802-4172-ad54-ed49b7697e0e","content":[{"type":"text","text":"按照蓝字提示进入下方界面，并根据提示完成操作","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"36d38409-e3ee-4970-8dbf-8b1a1f2768ce","content":[]},{"type":"image","props":{"backgroundColor":"default","textAlignment":"left","url":"assets/fd5f26b8-aec5-4fe9-b95f-7c6449c3bc26.jpg","name":"IMG_1010.jpeg","caption":"","showPreview":true,"previewWidth":562},"id":"15ff1759-27ce-4067-88c4-cb03fa2d76e1"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"b630fb7d-bf8a-42cb-b474-05a50e750f48","content":[{"type":"text","text":"接下来回到这个界面，开始创建第一个工程，（请根据图中提示操作）","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"73744bba-7e73-4d4b-aac2-f897f8fa40cb","content":[]},{"type":"image","props":{"backgroundColor":"default","textAlignment":"left","url":"assets/57942629-1c20-4faa-8a20-ff474eb31874.jpg","name":"IMG_1013.jpeg","caption":"","showPreview":true,"previewWidth":502},"id":"9dec16ef-acc4-4f1e-a000-c1d1550fdecf"},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"931ad24f-071c-4e45-8fda-8aadc74e2336","content":[]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"eb2de410-4b86-4c67-b36b-7b6774639be8","content":[{"type":"text","text":"接下来你可以说一声你好，或者问问它可以帮你什么。","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"e7167b88-ce62-41e3-915b-c3ce7e38d776","content":[{"type":"text","text":"如果说你看见了结果，那么恭喜你已经会初步使用DSH了！👏","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"bfe24223-1224-427a-ae61-e9e16ae8dadc","content":[]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"8cb731b3-7e86-449a-ab9d-383b5923d473","content":[{"type":"text","text":"加油，希望你继续探索！","styles":{"bold":true}}]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"8e1c96ac-e822-41a5-a373-3edd31ce9e88","content":[]},{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"78d1a622-8c60-4c1d-972d-3a65247cb907","content":[]}],"text":"本文档将使用DeepSeek（以下简称ds）搭配DeepSeek（以下简称dsh）进行演示如何使用一个harness并开始你的项目。\n\n\n\n\nSTEP I  找到官网\n找到ds的官方网页，并进入。官网我会放在下面。（真的服了，有些浏览器会给你一堆垃圾网页，不显示你真正要找的，给我看力竭了。）                                                                                      \n\n\nDeepSeek https://www.deepseek.com/\n\n\n（截止到截图时间2026年10月17号ds官方网页如上图所示）\n\n\nSTEP II 氪金 \n进入“API开放平台”，如下图所示（别告诉我就在中间也找不到，实在不行让ds给你网址好吧）\n\n\n然后到充值界面去氪金一下。氪多少随便你。\n接着去API keys界面，如下图所示，创建key（s），（记得c+v一下，就只会显示一次，但是没有复制上也没关系，再创建一个就好，反正能创建几百个来着，旧的那个你删掉留着都行。注意：不要把自己的key交给别人！这毕竟是和钱联系的东西。此外我推荐一个harness之类的用一个，或者说有分类意识，不管这个也行，看你心情。）\n（不过目前你不去用key也可以，因为有dsh可以直接登录ds账号，直接从你账号上的金额扣钱）\n\n\n\nSTEP III  下载\n\n回到ds官网首页，点击Harness桌面端\nDeepSeekHarness https://www.deepseek.com/harness/\n \n你应该会进入这个界面\n\n接下来根据你自己的电脑选择安装mac还是win，我们用win来演示，大部分人的应该都是win本，（它这个应该也会自动识别你的系统，所以直接下载也没啥问题。为什么没有Linux啊😭。）\n\n下载好以后找到你下载的内容（这个应该做得到吧，不需要我单独开一期吧🤔）\n以win为例 会得到这个\n\n\n直接双击运行它，然后会看见下图\n\n\nSTEP IV 配置与使用\n安装好启动以后，应该是如图所示界面\n\n\n按照蓝字提示进入下方界面，并根据提示完成操作\n\n\n接下来回到这个界面，开始创建第一个工程，（请根据图中提示操作）\n\n\n\n接下来你可以说一声你好，或者问问它可以帮你什么。\n如果说你看见了结果，那么恭喜你已经会初步使用DSH了！👏\n\n加油，希望你继续探索！\n\n","tags":[]},{"id":"c71e0000-0000-4000-8000-000000000005","title":"Claude Opus","parentId":null,"position":5,"kind":"reference","version":1,"publishedAt":"2026-10-17T09:54:13.442Z","blocks":[{"type":"paragraph","props":{},"content":[]},{"type":"linkCard","props":{"title":"Claude Opus","url":"https://platform.claude.com/docs/en/models/opus-5-5/overview"}}],"text":"\nClaude Opus https://platform.claude.com/docs/en/models/opus-5-5/overview"},{"id":"1954556a-247c-4e3c-a436-96a3969bebdd","title":"DSH（DeepSeekHarness）","parentId":"f3d29edd-ce5d-43f5-9cda-e61ca8038704","position":5,"kind":"document","version":3,"updatedAt":"2026-10-17T09:13:57.666Z","publishedAt":"2026-10-17T10:42:52.362Z","blocks":[{"type":"paragraph","props":{"textColor":"default","backgroundColor":"default","textAlignment":"left"},"id":"d95c2454-5cdc-4f9c-9319-c51bb1565e09","content":[{"type":"text","text":"直接参考example","styles":{}}]}],"text":"直接参考example"},{"id":"c71e0000-0000-4000-8000-000000000006","title":"Claude Sonnet","parentId":null,"position":6,"kind":"reference","version":1,"publishedAt":"2026-10-17T09:54:13.442Z","blocks":[{"type":"paragraph","props":{},"content":[]},{"type":"linkCard","props":{"title":"Claude Sonnet","url":"https://platform.claude.com/docs/en/models/sonnet-5-5/overview"}}],"text":"\nClaude Sonnet https://platform.claude.com/docs/en/models/sonnet-5-5/overview"},{"id":"c71e0000-0000-4000-8000-000000000007","title":"Codex","parentId":null,"position":7,"kind":"reference","version":1,"publishedAt":"2026-10-17T09:54:13.442Z","blocks":[{"type":"paragraph","props":{},"content":[]},{"type":"linkCard","props":{"title":"Codex","url":"https://developers.openai.com/codex/"}}],"text":"\nCodex https://developers.openai.com/codex/"},{"id":"c71e0000-0000-4000-8000-000000000008","title":"DeepSeek","parentId":null,"position":8,"kind":"reference","version":1,"publishedAt":"2026-10-17T09:54:13.442Z","blocks":[{"type":"paragraph","props":{},"content":[]},{"type":"linkCard","props":{"title":"DeepSeek","url":"https://www.deepseek.com/"}}],"text":"\nDeepSeek https://www.deepseek.com/"},{"id":"c71e0000-0000-4000-8000-000000000009","title":"GPT","parentId":null,"position":9,"kind":"reference","version":1,"publishedAt":"2026-10-17T09:54:13.442Z","blocks":[{"type":"paragraph","props":{},"content":[]},{"type":"linkCard","props":{"title":"GPT","url":"https://developers.openai.com/api/docs/models"}}],"text":"\nGPT https://developers.openai.com/api/docs/models"},{"id":"c71e0000-0000-4000-8000-000000000010","title":"GPT-6 Astra","parentId":null,"