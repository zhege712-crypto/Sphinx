{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howtoagent-workspace",
  "account_id": "48720c9632014847eacd7a8bf8a8994b",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "vars": {
    "APP_ORIGIN": "https://howtoagent-workspace.zhege712-872.workers.dev",
    "OWNER_GITHUB_ID": "301592077",
    "GITHUB_REPOSITORY": "zhege712-crypto/Sphinx",
    "GITHUB_BRANCH": "main",
    "SITE_TITLE": "Sphinx"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "howtoagent-content", "database_id": "cfbcc707-81dc-47f9-a425-af1d309238e0" }],
  "triggers": { "crons": ["17 * * * *"] }
}
